decoding=\"async\" width=\"900\" height=\"545\" data-id=\"29307\" src=\"/wp-content/uploads/2025/04/T950_2.png\" alt=\"\" class=\"wp-image-29307\" srcset=\"/wp-content/uploads/2025/04/T950_2.png 900w, /wp-content/uploads/2025/04/T950_2-300x182.png 300w, /wp-content/uploads/2025/04/T950_2-768x465.png 768w, /wp-content/uploads/2025/04/T950_2-600x363.png 600w\" sizes=\"auto, (max-width: 900px) 100vw, 900px\" /></a></figure>\n</figure>\n</div>\n    </article>\n  </div>\n</div>","sliders":{}}